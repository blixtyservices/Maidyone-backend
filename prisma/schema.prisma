generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum LoginType {
  PHONE
  GOOGLE
  APPLE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  RESET_PASSWORD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  STARTED
  COMPLETED
  CANCELLED
}

enum BookingType {
  INSTANT
  SCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  WALLET
}

enum CouponType {
  FLAT
  PERCENTAGE
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum NotificationType {
  BOOKING
  PAYMENT
  OFFER
  GENERAL
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

//////////////////////////////////////////////////////
// USER (Added to resolve relation dependencies)
//////////////////////////////////////////////////////

model User {
  id        String     @id @default(cuid())

  fullName  String
  phone     String     @unique
  email     String?    @unique
  password  String?

  profileImage String?

  refreshToken       String?
  refreshTokenExpiry DateTime?

  lastLoginAt DateTime?

  status    UserStatus @default(ACTIVE)
  loginType LoginType  @default(PHONE)

  otps          Otp[]
  addresses     Address[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]
  cart          Cart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// OTP
//////////////////////////////////////////////////////

model Otp {
  id        String     @id @default(cuid())
  phone     String
  code      String
  purpose   OtpPurpose
  attempts  Int        @default(0)
  verified  Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// ADDRESS
//////////////////////////////////////////////////////

model Address {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  phone    String

  label String?

  houseNo String?

  houseNumber String?

  floor String?

  landmark String?

  area String

  city String

  state String

  pincode String

  addressType AddressType @default(HOME)

  latitude Float?

  longitude Float?

  isDefault Boolean @default(false)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  icon         String?
  image        String?
  banner       String?
  color        String?
  displayOrder Int     @default(0)
  isFeatured   Boolean @default(false)
  isActive     Boolean @default(true)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// BANNER
//////////////////////////////////////////////////////

model Banner {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  pill1         String?
  pill2         String?
  estimatedTime String?
  rating        Float?
  buttonText    String?
  image         String
  redirectUrl   String?
  redirectType  String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

//////////////////////////////////////////////////////
// SERVICE
//////////////////////////////////////////////////////

model Service {
  id String @id @default(cuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name        String
  slug        String  @unique
  description String?

  image String?

  displayPriceMin Decimal? @db.Decimal(10, 2)
  displayPriceMax Decimal? @db.Decimal(10, 2)

  durationMinutes Int?

  rating        Float @default(0)
  totalReviews  Int   @default(0)
  totalBookings Int   @default(0)

  isFeatured Boolean @default(false)
  isPopular  Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages  Package[]
  bookings  Booking[]
  reviews   Review[]
  cartItems CartItem[]
}

//////////////////////////////////////////////////////
// PACKAGE
//////////////////////////////////////////////////////

model Package {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  duration      Int // Duration in minutes
  features      Json?
  isRecommended Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings  Booking[]
  cartItems CartItem[]

  @@index([serviceId])
}

//////////////////////////////////////////////////////
// BOOKING
//////////////////////////////////////////////////////

model Booking {
  id            String @id @default(cuid())
  bookingNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  bookingType BookingType

  bookingDate DateTime
  bookingTime String?

  startTime DateTime?
  endTime   DateTime?

  servicePrice Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  gst          Decimal @default(0) @db.Decimal(10, 2)
  platformFee  Decimal @default(0) @db.Decimal(10, 2)
  finalAmount  Decimal @db.Decimal(10, 2)

  startOtp String?
  endOtp   String?

  bookingStatus BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  @@index([userId])
  @@index([partnerId])
  @@index([serviceId])
  @@index([addressId])
  @@index([couponId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([bookingType])
  @@index([bookingDate])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  paymentGateway String?
  paymentId      String?
  orderId        String?
  signature      String?

  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  refundAmount Decimal? @db.Decimal(10, 2)
  refundId     String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

//////////////////////////////////////////////////////
// COUPON
//////////////////////////////////////////////////////

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  title           String
  description     String?
  couponType      CouponType
  value           Decimal    @db.Decimal(10, 2)
  minimumAmount   Decimal    @db.Decimal(10, 2)
  maximumDiscount Decimal?   @db.Decimal(10, 2)
  usageLimit      Int
  usedCount       Int        @default(0)
  isActive        Boolean    @default(true)
  expiresAt       DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  bookings Booking[]
}

//////////////////////////////////////////////////////
// PARTNER
//////////////////////////////////////////////////////

model Partner {
  id String @id @default(cuid())

  fullName     String
  phone        String  @unique
  email        String? @unique
  password     String?
  profileImage String?

  aadhaarNumber  String? @unique
  panNumber      String? @unique
  drivingLicense String?

  experience  Int?
  rating      Float         @default(0)
  totalJobs   Int           @default(0)
  isAvailable Boolean       @default(false)
  latitude    Float?
  longitude   Float?
  status      PartnerStatus @default(PENDING)

  accountHolderName String?
  bankName          String?
  accountNumber     String?
  ifscCode          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet   Wallet?
  bookings Booking[]
  reviews  Review[]

  @@index([phone])
  @@index([latitude, longitude])
  @@index([status])
}

//////////////////////////////////////////////////////
// WALLET
//////////////////////////////////////////////////////

model Wallet {
  id        String  @id @default(cuid())
  partnerId String  @unique
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  balance        Decimal @default(0) @db.Decimal(10, 2)
  totalEarned    Decimal @default(0) @db.Decimal(10, 2)
  totalWithdrawn Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

//////////////////////////////////////////////////////
// WALLET TRANSACTION
//////////////////////////////////////////////////////

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount          Decimal               @db.Decimal(10, 2)
  transactionType WalletTransactionType
  description     String?
  createdAt       DateTime              @default(now())

  @@index([walletId])
}

//////////////////////////////////////////////////////
// REVIEW
//////////////////////////////////////////////////////

model Review {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  rating    Float
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([partnerId])
  @@index([serviceId])
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType @default(GENERAL)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////

model Cart {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

//////////////////////////////////////////////////////
// CART ITEM
//////////////////////////////////////////////////////

model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([serviceId])
  @@index([packageId])
}
