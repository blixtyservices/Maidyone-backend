generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum LoginType {
  PHONE
  GOOGLE
  APPLE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id              String      @id @default(cuid())

  fullName        String
  email           String?     @unique
  phone           String      @unique
  password        String?

  profileImage    String?

  loginType       LoginType   @default(PHONE)

  isVerified      Boolean     @default(false)

  status          UserStatus  @default(ACTIVE)

  lastLoginAt     DateTime?

  refreshToken    String?

  refreshTokenExpiry DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  otps            Otp[]
  addresses       Address[]
  bookings        Booking[]
  reviews         Review[]
  notifications   Notification[]

  @@index([phone])
}
//////////////////////////////////////////////////////
// OTP
//////////////////////////////////////////////////////

model Otp {
  id          String      @id @default(cuid())

  phone       String

  code        String

  purpose     OtpPurpose

  attempts    Int         @default(0)

  verified    Boolean     @default(false)

  expiresAt   DateTime

  createdAt   DateTime    @default(now())

  userId      String?

  user        User?       @relation(fields: [userId], references: [id])

  @@index([phone])

  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// ADDRESS
//////////////////////////////////////////////////////

model Address {

  id              String        @id @default(cuid())

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  userId          String

  user            User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  //////////////////////////////////////
  // Personal Details
  //////////////////////////////////////

  fullName        String

  phone           String

  //////////////////////////////////////
  // Address
  //////////////////////////////////////

  houseNo         String

  area            String

  landmark        String?

  city            String

  state           String

  country         String        @default("India")

  pincode         String

  //////////////////////////////////////
  // GPS
  //////////////////////////////////////

  latitude        Float?

  longitude       Float?

  //////////////////////////////////////
  // Address Type
  //////////////////////////////////////

  addressType     AddressType

  label           String?

  isDefault       Boolean       @default(false)

  //////////////////////////////////////
  // Time
  //////////////////////////////////////

  createdAt       DateTime      @default(now())

  updatedAt       DateTime      @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  bookings        Booking[]

  @@index([userId])

  @@index([city])

  @@index([pincode])
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {

  id              String      @id @default(cuid())

  name            String

  slug            String      @unique

  description     String?

  image           String?

  icon            String?

  bannerImage     String?

  isActive        Boolean     @default(true)

  displayOrder    Int         @default(0)

  createdAt       DateTime    @default(now())

  updatedAt       DateTime    @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  services        Service[]

  @@index([slug])

  @@index([isActive])

}

//////////////////////////////////////////////////////
// SERVICE
//////////////////////////////////////////////////////

model Service {

  id              String      @id @default(cuid())

  categoryId      String

  category        Category @relation(
    fields:[categoryId],
    references:[id],
    onDelete: Cascade
  )

  //////////////////////////////////////
  // Information
  //////////////////////////////////////

  name            String

  slug            String      @unique

  description     String?

  shortDescription String?

  image           String?

  bannerImage     String?

  //////////////////////////////////////
  // Pricing
  //////////////////////////////////////

  basePrice       Float

  duration        Int          // Minutes

  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())

  updatedAt       DateTime     @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  packages        Package[]

  bookings        Booking[]

  reviews         Review[]

  @@index([categoryId])

  @@index([slug])

}

//////////////////////////////////////////////////////
// PACKAGE
//////////////////////////////////////////////////////

model Package {

  id              String      @id @default(cuid())

  serviceId       String

  service         Service @relation(
    fields:[serviceId],
    references:[id],
    onDelete: Cascade
  )

  //////////////////////////////////////
  // Package Info
  //////////////////////////////////////

  name            String

  description     String?

  //////////////////////////////////////
  // Pricing
  //////////////////////////////////////

  price           Float

  duration        Int

  //////////////////////////////////////
  // Features
  //////////////////////////////////////

  features        Json?

  isRecommended   Boolean      @default(false)

  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())

  updatedAt       DateTime     @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  bookings        Booking[]

  @@index([serviceId])

}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum BookingStatus {
  PENDING
  ACCEPTED
  PARTNER_ASSIGNED
  PARTNER_ARRIVING
  OTP_VERIFICATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  WALLET
}

enum CouponType {
  FLAT
  PERCENTAGE
}

//////////////////////////////////////////////////////
// BOOKING
//////////////////////////////////////////////////////

model Booking {

  id                String          @id @default(cuid())

  bookingNumber     String          @unique

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  userId            String

  user              User @relation(
    fields:[userId],
    references:[id]
  )

  serviceId         String

  service           Service @relation(
    fields:[serviceId],
    references:[id]
  )

  packageId         String

  package           Package @relation(
    fields:[packageId],
    references:[id]
  )

  addressId         String

  address           Address @relation(
    fields:[addressId],
    references:[id]
  )

  couponId          String?

  coupon            Coupon? @relation(
    fields:[couponId],
    references:[id]
  )

  //////////////////////////////////////
  // Schedule
  //////////////////////////////////////

  bookingDate       DateTime

  startTime         DateTime?

  endTime           DateTime?

  //////////////////////////////////////
  // Pricing
  //////////////////////////////////////

  servicePrice      Float

  discount          Float           @default(0)

  gst               Float           @default(0)

  platformFee       Float           @default(0)

  finalAmount       Float

  //////////////////////////////////////
  // OTP
  //////////////////////////////////////

  startOtp          String?

  endOtp            String?

  //////////////////////////////////////
  // Status
  //////////////////////////////////////

  bookingStatus     BookingStatus   @default(PENDING)

  paymentStatus     PaymentStatus   @default(PENDING)

  //////////////////////////////////////
  // Other
  //////////////////////////////////////

  notes             String?

  createdAt         DateTime        @default(now())

  updatedAt         DateTime        @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  payment Payment?

  @@index([userId])

  @@index([bookingStatus])

  @@index([paymentStatus])

}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {

  id                String          @id @default(cuid())

  bookingId         String          @unique

  booking           Booking @relation(
    fields:[bookingId],
    references:[id],
    onDelete: Cascade
  )

  //////////////////////////////////////
  // Gateway
  //////////////////////////////////////

  paymentGateway    String?

  paymentId         String?

  orderId           String?

  signature         String?

  //////////////////////////////////////
  // Amount
  //////////////////////////////////////

  amount            Float

  paymentMethod     PaymentMethod

  paymentStatus     PaymentStatus   @default(PENDING)

  //////////////////////////////////////
  // Refund
  //////////////////////////////////////

  refundAmount      Float?

  refundId          String?

  //////////////////////////////////////
  // Time
  //////////////////////////////////////

  paidAt            DateTime?

  createdAt         DateTime        @default(now())

  updatedAt         DateTime        @updatedAt

}

//////////////////////////////////////////////////////
// COUPON
//////////////////////////////////////////////////////

model Coupon {

  id                String          @id @default(cuid())

  code              String          @unique

  title             String

  description       String?

  couponType        CouponType

  value             Float

  minimumAmount     Float

  maximumDiscount   Float?

  usageLimit        Int

  usedCount         Int             @default(0)

  isActive          Boolean         @default(true)

  expiresAt         DateTime

  createdAt         DateTime        @default(now())

  updatedAt         DateTime        @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  bookings          Booking[]

}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum NotificationType {
  BOOKING
  PAYMENT
  OFFER
  GENERAL
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

//////////////////////////////////////////////////////
// PARTNER
//////////////////////////////////////////////////////

model Partner {

  id                String      @id @default(cuid())

  //////////////////////////////////////
  // Personal Information
  //////////////////////////////////////

  fullName          String

  phone             String      @unique

  email             String?     @unique

  password          String?

  profileImage      String?

  //////////////////////////////////////
  // KYC
  //////////////////////////////////////

  aadhaarNumber     String?

  panNumber         String?

  drivingLicense    String?

  //////////////////////////////////////
  // Work
  //////////////////////////////////////

  experience        Int?

  rating            Float       @default(0)

  totalJobs         Int         @default(0)

  isAvailable       Boolean     @default(false)

  latitude          Float?

  longitude         Float?

  status            PartnerStatus @default(PENDING)

  //////////////////////////////////////
  // Bank Details
  //////////////////////////////////////

  accountHolderName String?

  bankName          String?

  accountNumber     String?

  ifscCode          String?

  //////////////////////////////////////
  // Time
  //////////////////////////////////////

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  wallet            Wallet?

  reviews           Review[]

}

//////////////////////////////////////////////////////
// WALLET
//////////////////////////////////////////////////////

model Wallet {

  id                String @id @default(cuid())

  partnerId         String @unique

  partner           Partner @relation(
    fields:[partnerId],
    references:[id],
    onDelete: Cascade
  )

  balance           Float @default(0)

  totalEarned       Float @default(0)

  totalWithdrawn    Float @default(0)

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt

  transactions      WalletTransaction[]

}

//////////////////////////////////////////////////////
// WALLET TRANSACTION
//////////////////////////////////////////////////////

model WalletTransaction {

  id                String @id @default(cuid())

  walletId          String

  wallet            Wallet @relation(
    fields:[walletId],
    references:[id],
    onDelete: Cascade
  )

  amount            Float

  transactionType   WalletTransactionType

  description       String?

  createdAt         DateTime @default(now())

}

//////////////////////////////////////////////////////
// REVIEW
//////////////////////////////////////////////////////

model Review {

  id                String @id @default(cuid())

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  userId            String

  user              User @relation(
    fields:[userId],
    references:[id],
    onDelete: Cascade
  )

  partnerId         String?

  partner           Partner? @relation(
    fields:[partnerId],
    references:[id]
  )

  serviceId         String

  service           Service @relation(
    fields:[serviceId],
    references:[id],
    onDelete: Cascade
  )

  //////////////////////////////////////
  // Review
  //////////////////////////////////////

  rating            Float

  comment           String?

  createdAt         DateTime @default(now())

}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {

  id                String @id @default(cuid())

  userId            String

  user              User @relation(
    fields:[userId],
    references:[id],
    onDelete: Cascade
  )

  title             String

  message           String

  notificationType  NotificationType

  isRead            Boolean @default(false)

  createdAt         DateTime @default(now())

}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {

  id                String          @id @default(cuid())

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  bookingId         String          @unique

  booking           Booking         @relation(
    fields:[bookingId],
    references:[id]
  )

  userId            String

  user              User            @relation(
    fields:[userId],
    references:[id]
  )

  //////////////////////////////////////
  // Razorpay
  //////////////////////////////////////

  razorpayOrderId   String?         @unique

  razorpayPaymentId String?         @unique

  razorpaySignature String?

  //////////////////////////////////////
  // Amount
  //////////////////////////////////////

  amount            Float

  paidAmount        Float           @default(0)

  currency          String          @default("INR")

  //////////////////////////////////////
  // Status
  //////////////////////////////////////

  paymentMethod     PaymentMethod

  paymentStatus     PaymentStatus   @default(PENDING)

  //////////////////////////////////////
  // Refund
  //////////////////////////////////////

  refundAmount      Float           @default(0)

  refundReason      String?

  refundedAt        DateTime?

  //////////////////////////////////////
  // Metadata
  //////////////////////////////////////

  notes             Json?

  createdAt         DateTime        @default(now())

  updatedAt         DateTime        @updatedAt
}

//////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////

model Cart {
  id          String   @id @default(cuid())

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  userId      String   @unique

  user        User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  //////////////////////////////////////
  // Time
  //////////////////////////////////////

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  items       CartItem[]
}

//////////////////////////////////////////////////////
// CART ITEM
//////////////////////////////////////////////////////

model CartItem {
  id          String   @id @default(cuid())

  //////////////////////////////////////
  // Relations
  //////////////////////////////////////

  cartId      String

  cart        Cart @relation(
    fields: [cartId],
    references: [id],
    onDelete: Cascade
  )

  serviceId   String

  service     Service @relation(
    fields: [serviceId],
    references: [id]
  )

  packageId   String

  package     Package @relation(
    fields: [packageId],
    references: [id]
  )

  //////////////////////////////////////
  // Item
  //////////////////////////////////////

  quantity    Int      @default(1)

  //////////////////////////////////////
  // Time
  //////////////////////////////////////

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt

  @@index([cartId])

  @@index([serviceId])

  @@index([packageId])
}